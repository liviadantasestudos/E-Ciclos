/**
 * AUTOMATIZAÇÃO - V2
 * Arquivo: Menu.gs
 * Função: Gerenciar menus, modais e pontes de comunicação com o HTML
 */

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('⚙️ Automatização')
    .addItem('🚀 Abrir Painel', 'abrirPainel')
    .addSeparator()
    .addItem('🔄 Atualizar Planilha', 'onOpen')
    .addItem('💡 Sobre a Solução', 'mostrarSobre')
    .addToUi();
}

function abrirPainel() {
  const html = HtmlService.createHtmlOutputFromFile('Painel')
    .setWidth(1100)
    .setHeight(750);
  SpreadsheetApp.getUi().showModelessDialog(html, ' ');
}

function abrirPainelDetalhes() {
  abrirPainel();
}

/**
 * PONTES DE COMUNICAÇÃO (HTML -> OUTROS ARQUIVOS .GS)
 */

// Ponte para o Sicronizacao.gs
function sincronizarPorComissao(comissao) {
  return executarSincronizacao(comissao, false);
}

// Ponte para o Notas.gs (Uma comissão)
function puxarNotasPorComissao(comissao) {
  puxarNotasAvaliadores(comissao);
  return `Notas da comissão ${comissao} consolidadas com sucesso!`;
}

// Ponte para o Notas.gs (Todas as comissões)
function puxarNotasTodasComissoes() {
  puxarNotasAvaliadores("TODAS");
  return "Todas as notas foram consolidadas com sucesso!";
}

